                        <StatusStartingTime>2025-01-01T00:00:00Z</StatusStartingTime>
                    </ServiceInformation>
                </TSPService>
                <!--
                  Service 3: substitution for the literally-described "servicio suspendido".
                  ETSI TS 119 612 defines no "suspended" status URI, pre- or post-eIDAS (verified
                  against DSS 6.4's TrustServiceStatus enum). "supervisionrevoked" is the closest
                  honest analog: a real, DSS-recognised, non-granted legacy status distinct from
                  "withdrawn" — see fixtures/tsl/README.md and tasks.md task 13 Notes for the
                  full resolution, approved by the coordinator instead of fabricating a URI DSS
                  would not recognise.
                -->
